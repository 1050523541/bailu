odels/2953485\n7. 配套：UMT5 / wan_2.1_vae 见 Comfy-Org Wan_2.1 / Wan_2.2 repackaged\n"],"color":"#432","bgcolor":"#653"},{"id":100,"type":"PrimitiveStringMultiline","pos":[220,970],"size":[360,180],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"值","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"字符串","name":"STRING","type":"STRING","slot_index":0,"links":[11]}],"title":"中文 运动提示","properties":{"cnr_id":"comfy-core","ver":"0.28.0","Node name for S&R":"PrimitiveStringMultiline"},"widgets_values":["二次元少女, 柔和哥特洛丽塔, 蕾丝与缎带,\n缓缓转头看向镜头, 发丝与缎带随风轻摆, 微笑, 轻微推镜,\n动作连贯, 人物稳定, 电影感柔光"]},{"id":101,"type":"TriPoseZhTagMap","pos":[600,970],"size":[440,410],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"text","name":"text","type":"STRING","link":11},{"localized_name":"dictionary","name":"dictionary","type":"COMBO","widget":{"name":"dictionary"},"link":null},{"localized_name":"custom_path","name":"custom_path","type":"STRING","widget":{"name":"custom_path"},"link":null},{"localized_name":"keep_unknown","name":"keep_unknown","type":"COMBO","widget":{"name":"keep_unknown"},"link":null},{"localized_name":"passthrough_english","name":"passthrough_english","type":"BOOLEAN","widget":{"name":"passthrough_english"},"link":null},{"localized_name":"google_fallback","name":"google_fallback","shape":7,"type":"BOOLEAN","widget":{"name":"google_fallback"},"link":null}],"outputs":[{"localized_name":"mapped_text","name":"mapped_text","type":"STRING","slot_index":0,"links":[12]},{"localized_name":"unmapped_text","name":"unmapped_text","type":"STRING","slot_index":1,"links":[]}],"title":"映射 运动","properties":{"Node name for S&R":"TriPoseZhTagMap"},"widgets_values":["danbooru_zh+nsfw","","keep",true,false,"二次元少女, pastel goth, 洛丽塔, lace, ribbon, 与, turning head, looking at viewer, 缓缓, 看向, hair strand, 随风轻摆, smile, 轻微推镜, painting (action), 连贯, figure, 稳定, soft lighting, 电影感","二次元少女, 洛丽塔, 与, 缓缓, 看向, 与, 随风轻摆, 轻微推镜, 连贯, 稳定, 电影感"]},{"id":10